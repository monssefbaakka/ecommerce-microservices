# Copy to infra/.env (ignored by git) to configure the "app" container and the services.
# Every variable is optional: without it the application uses its dev default (except on a server, see the end).

# Base64 key of at least 256 bits, e.g. generated with: openssl rand -base64 32
# Shared by all of them: auth-service issues the tokens, the monolith and the other services check them
# JWT_SECRET=

# Token lifetime (Spring Duration: 30m, 1h, 1d...)
# JWT_EXPIRATION=1h

# Creates an ADMIN account at startup when both are set and the email is free
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please

# Only with infra/docker-compose.ghcr.yml (images published by the CI, nothing built here):
# version of the images, "latest" by default (last image of main), or "sha-<short sha>", "1.2.0", "1.2"
# IMAGE_TAG=latest
# Registry and owner of the images, e.g. the images published by a fork
# IMAGE_REGISTRY=ghcr.io/monssefbaakka

# Only on a server, with infra/docker-compose.prod.yml (see docs/deployment.md):
# password of the PostgreSQL user, required there (no dev default). Read when the volume is created
# POSTGRES_PASSWORD=
# Domain served over HTTPS by Caddy, certificate from Let's Encrypt. Without a domain of your own,
# <server IP with dashes>.sslip.io points to the server, e.g. 203-0-113-10.sslip.io. Not set: plain HTTP on port 80
# DOMAIN=shop.example.com
