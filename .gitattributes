# Normalize text files to LF in the repository
* text=auto

# Shell scripts run inside Linux containers and CI: always LF, even on a Windows checkout
mvnw text eol=lf
*.sh text eol=lf

# Windows scripts keep CRLF
*.cmd text eol=crlf

# SQL scripts (Flyway migrations, PostgreSQL init) are read on Linux, in the containers and CI: always LF.
# Flyway's checksum ignores line endings, but a migration then has the same bytes on every machine
*.sql text eol=lf
