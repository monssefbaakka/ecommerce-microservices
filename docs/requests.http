@host = http://localhost:8080
# Must match ADMIN_EMAIL / ADMIN_PASSWORD used to start the app (see README)
@adminEmail = admin@example.com
@adminPassword = admin-pass

### 0. Log in as ADMIN first: write requests on categories and products reuse this token
# @name adminLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

### 1. Create a category (expect 201)
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Electronics", "description": "Phones and laptops" }

### 2. List categories (expect 200)
GET {{host}}/api/categories

### 3. Get one category (expect 200)
GET {{host}}/api/categories/1

### 4. Update a category (expect 200)
PUT {{host}}/api/categories/1
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Electronics", "description": "Updated description" }

### 5. Duplicate name (expect 409)
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "electronics", "description": "Same name, different case" }

### 6. Blank name (expect 400)
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "", "description": "Invalid" }

### 7. Unknown id (expect 404)
GET {{host}}/api/categories/999

### 8. Delete a category (expect 204)
DELETE {{host}}/api/categories/1
Authorization: Bearer {{adminLogin.response.body.$.token}}

### 9. Delete again (expect 404)
DELETE {{host}}/api/categories/1
Authorization: Bearer {{adminLogin.response.body.$.token}}



############################################################
# PRODUCTS (run in order, top to bottom)
############################################################

### P1. Create a category for the tests (expect 201)
# @name createCategory
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Phones {{$timestamp}}", "description": "Category used by product tests" }

### P2. Create a product (expect 201)
# @name createProduct
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "name": "iPhone 15",
  "description": "128 GB",
  "price": 999.99,
  "categoryId": {{createCategory.response.body.$.id}},
  "stock": 25
}

### P3. List products (expect 200)
GET {{host}}/api/products

### P4. Get the product (expect 200)
GET {{host}}/api/products/{{createProduct.response.body.$.id}}

### P5. Update the product (expect 200, new price)
PUT {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "name": "iPhone 15",
  "description": "256 GB",
  "price": 1099.99,
  "categoryId": {{createCategory.response.body.$.id}},
  "stock": 20
}

### P6. Blank name (expect 400)
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "", "price": 10.00, "categoryId": {{createCategory.response.body.$.id}}, "stock": 1 }

### P7. Price is zero (expect 400)
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Free phone", "price": 0, "categoryId": {{createCategory.response.body.$.id}}, "stock": 1 }

### P8. No category id (expect 400)
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "No category id", "price": 10.00, "stock": 1 }

### P9. Unknown category (expect 404)
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Ghost category", "price": 10.00, "categoryId": 999999, "stock": 1 }

### P10. Unknown product (expect 404)
GET {{host}}/api/products/999999

### P11. Delete the category while a product uses it (expect 409)
DELETE {{host}}/api/categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### P12. Delete the product (expect 204)
DELETE {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### P13. Delete the product again (expect 404)
DELETE {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### P14. Now the category can be deleted (expect 204)
DELETE {{host}}/api/categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
### P15 - pagination
GET http://localhost:8080/api/products?page=0&size=5

### P16 - recherche par nom
GET http://localhost:8080/api/products?name=phone

### P17 - filtre par catégorie
GET http://localhost:8080/api/products?categoryId=1

### P18 - tout combiné
GET http://localhost:8080/api/products?name=phone&categoryId=1&page=0&size=5&sort=price,desc



############################################################
# AUTH
############################################################

### A1. Register a new user (expect 201, role USER, no password in response)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "user{{$timestamp}}@example.com", "password": "secret123" }

### A2. Fixed email: run twice (expect 201, then 409)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "secret123" }

### A3. Invalid email (expect 400)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "not-an-email", "password": "secret123" }

### A4. Password too short (expect 400)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "short@example.com", "password": "123" }

### A5. Login with the account from A2 (expect 200, token + tokenType Bearer + expiresIn)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "secret123" }

### A6. Wrong password (expect 401, same message as unknown email)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "wrong-pass" }

### A7. Unknown email (expect 401)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "ghost@example.com", "password": "secret123" }

### A8. Missing password (expect 400)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "" }

### A9. Read the catalog without a token (expect 200: GET is public)
GET {{host}}/api/products

### A10. Write without a token (expect 401)
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "No token", "description": "Rejected" }

### A11. Write with a USER token from A5 (expect 403: ADMIN only)
POST {{host}}/api/categories
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{ "name": "User token", "description": "Rejected" }

### A12. Tampered token (expect 401)
POST {{host}}/api/categories
Content-Type: application/json
Authorization: Bearer not-a-valid-token

{ "name": "Bad token", "description": "Rejected" }


############################################################
# CART (run in order; needs request 0 and the account from A2)
############################################################

### C1. Create a category for the cart tests (expect 201)
# @name cartCategory
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Cart tests", "description": "Products used by the cart requests" }

### C2. Create a product for the cart tests (expect 201)
# @name cartProduct
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Headphones", "description": "Wireless", "price": 59.90, "categoryId": {{cartCategory.response.body.$.id}}, "stock": 10 }

### C3. Log in as USER (expect 200)
# @name userLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "secret123" }

### C4. Empty cart (expect 200, items [], total 0)
GET {{host}}/api/cart
Authorization: Bearer {{userLogin.response.body.$.token}}

### C5. Add 2 headphones (expect 200, quantity 2, total 119.80)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 2 }

### C6. Add the same product again (expect 200, still one line, quantity 3)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 1 }

### C7. Change the quantity (expect 200, quantity 5)
PUT {{host}}/api/cart/items/{{cartProduct.response.body.$.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "quantity": 5 }

### C8. Quantity 0 (expect 400)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 0 }

### C9. Unknown product (expect 404)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": 999999, "quantity": 1 }

### C10. Cart without a token (expect 401)
GET {{host}}/api/cart

### C11. Remove the product (expect 200, items [])
DELETE {{host}}/api/cart/items/{{cartProduct.response.body.$.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}

### C12. Remove it again (expect 404: not in the cart)
DELETE {{host}}/api/cart/items/{{cartProduct.response.body.$.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}

### C13. Empty the cart (expect 204)
DELETE {{host}}/api/cart
Authorization: Bearer {{userLogin.response.body.$.token}}


############################################################
# ORDERS (run in order, after the cart requests: C13 leaves the cart empty)
############################################################

### O1. Order with an empty cart (expect 400 "Cart is empty")
POST {{host}}/api/orders
Authorization: Bearer {{userLogin.response.body.$.token}}

### O2. Put 2 headphones in the cart (expect 200, total 119.80)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 2 }

### O3. Place the order (expect 201, Location header, status PENDING, total 119.80)
# @name placedOrder
POST {{host}}/api/orders
Authorization: Bearer {{userLogin.response.body.$.token}}

### O4. The cart is now empty (expect 200, items [])
GET {{host}}/api/cart
Authorization: Bearer {{userLogin.response.body.$.token}}

### O5. Read the order (expect 200, same lines and total as O3)
GET {{host}}/api/orders/{{placedOrder.response.body.$.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}

### O6. Unknown order (expect 404)
GET {{host}}/api/orders/999999
Authorization: Bearer {{userLogin.response.body.$.token}}

### O7. Order without a token (expect 401)
POST {{host}}/api/orders

### O8. The order took 2 units (expect 200, stock 8)
GET {{host}}/api/products/{{cartProduct.response.body.$.id}}

### O9. More than the stock in the cart (expect 409 "Not enough stock ... 8 left")
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 9 }

### O10. Put 3 in the cart (expect 200)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 3 }

### O11. ADMIN lowers the stock to 1 (expect 200, stock 1)
PUT {{host}}/api/products/{{cartProduct.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Headphones", "description": "Wireless", "price": 59.90, "categoryId": {{cartCategory.response.body.$.id}}, "stock": 1 }

### O12. Order the 3 (expect 409: only 1 left, the cart and the stock are unchanged)
POST {{host}}/api/orders
Authorization: Bearer {{userLogin.response.body.$.token}}

### O13. Empty the cart (expect 204)
DELETE {{host}}/api/cart
Authorization: Bearer {{userLogin.response.body.$.token}}

### O14. My order history (expect 200, newest first, page.totalElements 1)
GET {{host}}/api/orders
Authorization: Bearer {{userLogin.response.body.$.token}}

### O15. History, page of 5 (expect 200, page.size 5)
GET {{host}}/api/orders?page=0&size=5
Authorization: Bearer {{userLogin.response.body.$.token}}

### O16. History without a token (expect 401)
GET {{host}}/api/orders

############################################################
# ERRORS (same JSON format: status, error, message, path, errors)
############################################################

### E1. Malformed JSON (expect 400)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "john@example.com",

### E2. Wrong type in the URL (expect 400)
GET {{host}}/api/products/abc

### E3. Unknown sort property (expect 400, "Invalid sort property: foo")
GET {{host}}/api/products?sort=foo

### E4. Method not supported (expect 405, header Allow)
DELETE {{host}}/api/auth/login

### E5. Not JSON (expect 415)
POST {{host}}/api/auth/login
Content-Type: text/plain

john@example.com

### E6. Unknown URL with a token (expect 404)
GET {{host}}/api/unknown
Authorization: Bearer {{adminLogin.response.body.$.token}}

### H1. Health without a token (expect 200, only {"status":"UP"})
GET {{host}}/actuator/health

### H2. Health with an ADMIN token (expect 200, with the db and diskSpace components)
GET {{host}}/actuator/health
Authorization: Bearer {{adminLogin.response.body.$.token}}

### H3. Liveness: the process works, never checks the database (expect 200)
GET {{host}}/actuator/health/liveness

### H4. Readiness: ready to serve requests, database included (expect 200, 503 if PostgreSQL is down)
GET {{host}}/actuator/health/readiness

### H5. Version, build time and JVM (expect 200)
GET {{host}}/actuator/info

### H6. Endpoint not exposed over HTTP (expect 401 without token, 404 for an ADMIN)
GET {{host}}/actuator/env


############################################################
# MICROSERVICES (docker compose --profile app up: gateway 8090, auth-service 8081, product-service 8082,
# order-service 8083, payment-service 8084, Eureka 8761)
############################################################
@gateway = http://localhost:8090
@authService = http://localhost:8081
@productService = http://localhost:8082
@orderService = http://localhost:8083
@paymentService = http://localhost:8084
@eureka = http://localhost:8761

### G1. Register through the gateway: routed to auth-service (expect 201, then 409 on a second run)
POST {{gateway}}/api/auth/register
Content-Type: application/json

{ "email": "gateway@example.com", "password": "password123" }

### G2. Login through the gateway: the token comes from auth-service (expect 200)
# @name gatewayLogin
POST {{gateway}}/api/auth/login
Content-Type: application/json

{ "email": "gateway@example.com", "password": "password123" }

### G3. Catalog through the gateway: routed to product-service (expect 200)
GET {{gateway}}/api/products

### G4. Cart through the gateway with the auth-service token: routed to order-service (expect 200)
GET {{gateway}}/api/cart
Authorization: Bearer {{gatewayLogin.response.body.$.token}}

### G5. No route for this path (expect 404, ErrorResponse from the gateway)
GET {{gateway}}/unknown

### G6. Stop auth-service first (docker stop ecommerce-auth-service), wait ~30 s (expect 503, ErrorResponse)
POST {{gateway}}/api/auth/login
Content-Type: application/json

{ "email": "gateway@example.com", "password": "password123" }

### G7. Gateway health and info (expect 200)
GET {{gateway}}/actuator/health

### G8. Route list not exposed: the gateway is public (expect 404)
GET {{gateway}}/actuator/gateway/routes

### C1. ADMIN login through the gateway (expect 200, needs ADMIN_EMAIL / ADMIN_PASSWORD in infra/.env)
# @name gatewayAdminLogin
POST {{gateway}}/api/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

### C2. Create a category through the gateway: written by product-service (expect 201)
# @name gatewayCategory
POST {{gateway}}/api/categories
Authorization: Bearer {{gatewayAdminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Gateway {{$timestamp}}", "description": "Created through product-service" }

### C3. Create a product in it (expect 201)
# @name gatewayProduct
POST {{gateway}}/api/products
Authorization: Bearer {{gatewayAdminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Gateway phone", "description": "64 GB", "price": 199.99, "categoryId": {{gatewayCategory.response.body.$.id}}, "stock": 5 }

### C4. Paging, search and filter like the monolith (expect 200, page.totalElements = 1)
GET {{gateway}}/api/products?name=gateway&categoryId={{gatewayCategory.response.body.$.id}}&page=0&size=5&sort=price,desc

### C5. Not in the monolith: product-service has its own product_db (expect 404, or another product with that id)
GET {{host}}/api/products/{{gatewayProduct.response.body.$.id}}

### C6. Write without a token (expect 401, ErrorResponse from product-service)
POST {{gateway}}/api/categories
Content-Type: application/json

{ "name": "No token", "description": "Rejected" }

### C7. Write with a USER token (expect 403)
POST {{gateway}}/api/categories
Authorization: Bearer {{gatewayLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "User token", "description": "Rejected" }

### C8. Delete the product, then the category (expect 204 twice)
DELETE {{gateway}}/api/products/{{gatewayProduct.response.body.$.id}}
Authorization: Bearer {{gatewayAdminLogin.response.body.$.token}}

###
DELETE {{gateway}}/api/categories/{{gatewayCategory.response.body.$.id}}
Authorization: Bearer {{gatewayAdminLogin.response.body.$.token}}

### C9. Stop product-service first (docker stop ecommerce-product-service), wait ~30 s (expect 503, ErrorResponse)
GET {{gateway}}/api/products

### W1. Order and pay through the gateway: ADMIN creates a category for it (expect 201, needs C1)
# @name shopCategory
POST {{gateway}}/api/categories
Authorization: Bearer {{gatewayAdminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Shop {{$timestamp}}", "description": "Order and payment scenario" }

### W2. A product with 5 units (expect 201)
# @name shopProduct
POST {{gateway}}/api/products
Authorization: Bearer {{gatewayAdminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Shop phone", "price": 199.99, "categoryId": {{shopCategory.response.body.$.id}}, "stock": 5 }

### W3. USER puts 2 in the cart: order-service asks product-service for name, price and stock (expect 200, total 399.98)
POST {{gateway}}/api/cart/items
Authorization: Bearer {{gatewayLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{shopProduct.response.body.$.id}}, "quantity": 2 }

### W4. Place the order (expect 201, status PENDING, total 399.98)
# @name shopOrder
POST {{gateway}}/api/orders
Authorization: Bearer {{gatewayLogin.response.body.$.token}}

### W5. The units were reserved in product-service by order-service (expect 200, stock 3)
GET {{gateway}}/api/products/{{shopProduct.response.body.$.id}}

### W6. Pay with a declined card (expect 201, status DECLINED)
POST {{gateway}}/api/payments
Authorization: Bearer {{gatewayLogin.response.body.$.token}}
Content-Type: application/json

{ "orderId": {{shopOrder.response.body.$.id}}, "cardNumber": "4000000000000002" }

### W7. The order is still PENDING (expect 200)
GET {{gateway}}/api/orders/{{shopOrder.response.body.$.id}}
Authorization: Bearer {{gatewayLogin.response.body.$.token}}

### W8. Pay with another card (expect 201, status SUCCEEDED, amount 399.98, cardLast4 4242)
POST {{gateway}}/api/payments
Authorization: Bearer {{gatewayLogin.response.body.$.token}}
Content-Type: application/json

{ "orderId": {{shopOrder.response.body.$.id}}, "cardNumber": "4242424242424242" }

### W9. order-service now shows PAID: payment-service called its /internal endpoint (expect 200)
GET {{gateway}}/api/orders/{{shopOrder.response.body.$.id}}
Authorization: Bearer {{gatewayLogin.response.body.$.token}}

### W10. Pay it again (expect 409 "Order ... is PAID, only a PENDING order can be paid")
POST {{gateway}}/api/payments
Authorization: Bearer {{gatewayLogin.response.body.$.token}}
Content-Type: application/json

{ "orderId": {{shopOrder.response.body.$.id}}, "cardNumber": "4242424242424242" }

### W11. Pay the order of someone else: the ADMIN token has no such order (expect 404)
POST {{gateway}}/api/payments
Authorization: Bearer {{gatewayAdminLogin.response.body.$.token}}
Content-Type: application/json

{ "orderId": {{shopOrder.response.body.$.id}}, "cardNumber": "4242424242424242" }

### W12. Card number of 15 digits (expect 400, errors[0].field cardNumber)
POST {{gateway}}/api/payments
Authorization: Bearer {{gatewayLogin.response.body.$.token}}
Content-Type: application/json

{ "orderId": {{shopOrder.response.body.$.id}}, "cardNumber": "424242424242424" }

### W13. My payments, newest first: the declined one is kept (expect 200, page.totalElements >= 2)
GET {{gateway}}/api/payments
Authorization: Bearer {{gatewayLogin.response.body.$.token}}

### W14. Payments without a token (expect 401, ErrorResponse from payment-service)
GET {{gateway}}/api/payments

### W15. Stop order-service first (docker stop ecommerce-order-service), wait ~30 s (expect 503, ErrorResponse)
GET {{gateway}}/api/cart
Authorization: Bearer {{gatewayLogin.response.body.$.token}}

### S1. auth-service directly, without the gateway (expect 200)
POST {{authService}}/api/auth/login
Content-Type: application/json

{ "email": "gateway@example.com", "password": "password123" }

### S2. auth-service readiness: database included (expect 200)
GET {{authService}}/actuator/health/readiness

### S3. product-service directly, without the gateway (expect 200)
GET {{productService}}/api/categories

### S4. product-service readiness: database included (expect 200)
GET {{productService}}/actuator/health/readiness

### S5. order-service directly, without the gateway (expect 200)
GET {{orderService}}/api/orders
Authorization: Bearer {{gatewayLogin.response.body.$.token}}

### S6. order-service readiness: database included (expect 200)
GET {{orderService}}/actuator/health/readiness

### S7. payment-service directly, without the gateway (expect 200)
GET {{paymentService}}/api/payments
Authorization: Bearer {{gatewayLogin.response.body.$.token}}

### S8. payment-service readiness: database included (expect 200)
GET {{paymentService}}/actuator/health/readiness

### R1. Instances registered in Eureka: API-GATEWAY, AUTH-SERVICE, PRODUCT-SERVICE, ORDER-SERVICE and PAYMENT-SERVICE, status UP (expect 200)
GET {{eureka}}/eureka/apps
Accept: application/json
