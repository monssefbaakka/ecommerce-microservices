@host = http://localhost:8080
# Must match ADMIN_EMAIL / ADMIN_PASSWORD used to start the app (see README)
@adminEmail = admin@example.com
@adminPassword = admin-pass

### 0. Log in as ADMIN first: write requests on categories and products reuse this token
# @name adminLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

### 1. Create a category (expect 201)
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Electronics", "description": "Phones and laptops" }

### 2. List categories (expect 200)
GET {{host}}/api/categories

### 3. Get one category (expect 200)
GET {{host}}/api/categories/1

### 4. Update a category (expect 200)
PUT {{host}}/api/categories/1
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Electronics", "description": "Updated description" }

### 5. Duplicate name (expect 409)
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "electronics", "description": "Same name, different case" }

### 6. Blank name (expect 400)
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "", "description": "Invalid" }

### 7. Unknown id (expect 404)
GET {{host}}/api/categories/999

### 8. Delete a category (expect 204)
DELETE {{host}}/api/categories/1
Authorization: Bearer {{adminLogin.response.body.$.token}}

### 9. Delete again (expect 404)
DELETE {{host}}/api/categories/1
Authorization: Bearer {{adminLogin.response.body.$.token}}



############################################################
# PRODUCTS (run in order, top to bottom)
############################################################

### P1. Create a category for the tests (expect 201)
# @name createCategory
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Phones {{$timestamp}}", "description": "Category used by product tests" }

### P2. Create a product (expect 201)
# @name createProduct
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "name": "iPhone 15",
  "description": "128 GB",
  "price": 999.99,
  "category": { "id": {{createCategory.response.body.$.id}} }
}

### P3. List products (expect 200)
GET {{host}}/api/products

### P4. Get the product (expect 200)
GET {{host}}/api/products/{{createProduct.response.body.$.id}}

### P5. Update the product (expect 200, new price)
PUT {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{
  "name": "iPhone 15",
  "description": "256 GB",
  "price": 1099.99,
  "category": { "id": {{createCategory.response.body.$.id}} }
}

### P6. Blank name (expect 400)
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "", "price": 10.00, "category": { "id": {{createCategory.response.body.$.id}} } }

### P7. Price is zero (expect 400)
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Free phone", "price": 0, "category": { "id": {{createCategory.response.body.$.id}} } }

### P8. Category without id (expect 400)
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "No category id", "price": 10.00, "category": { } }

### P9. Unknown category (expect 404)
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Ghost category", "price": 10.00, "category": { "id": 999999 } }

### P10. Unknown product (expect 404)
GET {{host}}/api/products/999999

### P11. Delete the category while a product uses it (expect 409)
DELETE {{host}}/api/categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### P12. Delete the product (expect 204)
DELETE {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### P13. Delete the product again (expect 404)
DELETE {{host}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}

### P14. Now the category can be deleted (expect 204)
DELETE {{host}}/api/categories/{{createCategory.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.token}}
### P15 - pagination
GET http://localhost:8080/api/products?page=0&size=5

### P16 - recherche par nom
GET http://localhost:8080/api/products?name=phone

### P17 - filtre par catégorie
GET http://localhost:8080/api/products?categoryId=1

### P18 - tout combiné
GET http://localhost:8080/api/products?name=phone&categoryId=1&page=0&size=5&sort=price,desc



############################################################
# AUTH
############################################################

### A1. Register a new user (expect 201, role USER, no password in response)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "user{{$timestamp}}@example.com", "password": "secret123" }

### A2. Fixed email: run twice (expect 201, then 409)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "secret123" }

### A3. Invalid email (expect 400)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "not-an-email", "password": "secret123" }

### A4. Password too short (expect 400)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "short@example.com", "password": "123" }

### A5. Login with the account from A2 (expect 200, token + tokenType Bearer + expiresIn)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "secret123" }

### A6. Wrong password (expect 401, same message as unknown email)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "wrong-pass" }

### A7. Unknown email (expect 401)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "ghost@example.com", "password": "secret123" }

### A8. Missing password (expect 400)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "" }

### A9. Read the catalog without a token (expect 200: GET is public)
GET {{host}}/api/products

### A10. Write without a token (expect 401)
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "No token", "description": "Rejected" }

### A11. Write with a USER token from A5 (expect 403: ADMIN only)
POST {{host}}/api/categories
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{ "name": "User token", "description": "Rejected" }

### A12. Tampered token (expect 401)
POST {{host}}/api/categories
Content-Type: application/json
Authorization: Bearer not-a-valid-token

{ "name": "Bad token", "description": "Rejected" }


############################################################
# CART (run in order; needs request 0 and the account from A2)
############################################################

### C1. Create a category for the cart tests (expect 201)
# @name cartCategory
POST {{host}}/api/categories
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Cart tests", "description": "Products used by the cart requests" }

### C2. Create a product for the cart tests (expect 201)
# @name cartProduct
POST {{host}}/api/products
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "name": "Headphones", "description": "Wireless", "price": 59.90, "categoryId": {{cartCategory.response.body.$.id}} }

### C3. Log in as USER (expect 200)
# @name userLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "duplicate@example.com", "password": "secret123" }

### C4. Empty cart (expect 200, items [], total 0)
GET {{host}}/api/cart
Authorization: Bearer {{userLogin.response.body.$.token}}

### C5. Add 2 headphones (expect 200, quantity 2, total 119.80)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 2 }

### C6. Add the same product again (expect 200, still one line, quantity 3)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 1 }

### C7. Change the quantity (expect 200, quantity 5)
PUT {{host}}/api/cart/items/{{cartProduct.response.body.$.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "quantity": 5 }

### C8. Quantity 0 (expect 400)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 0 }

### C9. Unknown product (expect 404)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": 999999, "quantity": 1 }

### C10. Cart without a token (expect 401)
GET {{host}}/api/cart

### C11. Remove the product (expect 200, items [])
DELETE {{host}}/api/cart/items/{{cartProduct.response.body.$.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}

### C12. Remove it again (expect 404: not in the cart)
DELETE {{host}}/api/cart/items/{{cartProduct.response.body.$.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}

### C13. Empty the cart (expect 204)
DELETE {{host}}/api/cart
Authorization: Bearer {{userLogin.response.body.$.token}}


############################################################
# ORDERS (run in order, after the cart requests: C13 leaves the cart empty)
############################################################

### O1. Order with an empty cart (expect 400 "Cart is empty")
POST {{host}}/api/orders
Authorization: Bearer {{userLogin.response.body.$.token}}

### O2. Put 2 headphones in the cart (expect 200, total 119.80)
POST {{host}}/api/cart/items
Authorization: Bearer {{userLogin.response.body.$.token}}
Content-Type: application/json

{ "productId": {{cartProduct.response.body.$.id}}, "quantity": 2 }

### O3. Place the order (expect 201, Location header, status PENDING, total 119.80)
# @name placedOrder
POST {{host}}/api/orders
Authorization: Bearer {{userLogin.response.body.$.token}}

### O4. The cart is now empty (expect 200, items [])
GET {{host}}/api/cart
Authorization: Bearer {{userLogin.response.body.$.token}}

### O5. Read the order (expect 200, same lines and total as O3)
GET {{host}}/api/orders/{{placedOrder.response.body.$.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}

### O6. Unknown order (expect 404)
GET {{host}}/api/orders/999999
Authorization: Bearer {{userLogin.response.body.$.token}}

### O7. Order without a token (expect 401)
POST {{host}}/api/orders
